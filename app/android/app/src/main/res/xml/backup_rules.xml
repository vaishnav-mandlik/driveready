<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower: same as data_extraction_rules.xml -->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <include domain="file" path="." />
    <exclude domain="database" path="async-storage/databases/content.sqlite" />
    <exclude domain="database" path="async-storage/databases/content.sqlite-wal" />
    <exclude domain="database" path="async-storage/databases/content.sqlite-shm" />
</full-backup-content>
